{% extends '_layouts/cp' %}
{% import '_includes/forms' as forms %}

{% set title = form.name %}
{% set selectedSubnavItem = 'forms' %}
{% set crumbs = [
    { label: settings.getNavLabel(), url: url('basin') },
    { label: 'Forms'|t('basin'), url: url('basin/forms') },
] %}

{% block actionButton %}
    <a class="btn" href="{{ form.basinUrl }}" target="_blank" rel="noopener" data-icon="external">{{ 'Open in Basin'|t('basin') }}</a>
{% endblock %}

{% block content %}
    {% include 'basin/_includes/state' with { state: 'ready' } %}

    {% if form.hasTurnstileProblem %}
        <blockquote class="note warning">
            <p>{{ 'This form requires Turnstile, but no Turnstile site key is set in Basin, so every submission will fail. Add your Cloudflare Turnstile keys in the form’s Spam settings in Basin.'|t('basin') }} <a href="{{ form.basinUrl }}" target="_blank" rel="noopener" data-icon="external">{{ 'Open in Basin'|t('basin') }}</a></p>
        </blockquote>
    {% endif %}

    {% if form.needsEmbedCode %}
        <blockquote class="note warning">
            <p>{{ 'This form is used with Basin’s Form Studio, but its embed code hasn’t been added yet, so the site can’t show it. Add it below.'|t('basin') }}</p>
        </blockquote>
    {% endif %}

    {% if studioStatus == 'broken' %}
        <blockquote class="note warning">
            <p>{{ 'The saved Form Studio embed code no longer works. The form may have been deleted or republished in Form Studio. Paste the current embed code below.'|t('basin') }}</p>
        </blockquote>
    {% endif %}

    {{ forms.copytextField({
        label: 'Endpoint URL'|t('basin'),
        instructions: 'To use your own markup, make this the form’s `action`. Every Basin form accepts submissions here, whether or not it also has a Form Studio embed.'|t('basin'),
        id: 'basin-endpoint',
        value: form.action,
        class: 'code',
    }) }}

    <hr>

    <h2>{{ 'Form Studio embed'|t('basin') }}</h2>
    {% if form.isStudioForm and studioStatus != 'broken' %}
        <p>{{ 'Saved. Templates can show this form’s Form Studio version with `craft.basin.render()`.'|t('basin')|md(inlineOnly=true) }}{% if studioStatus == 'unknown' %} <span class="light">{{ 'Basin couldn’t be reached to check it just now.'|t('basin') }}</span>{% endif %}</p>
        <p><code>{{ form.studioScriptUrl }}</code></p>
        {% if canManage %}
            <form method="post" accept-charset="UTF-8">
                {{ csrfInput() }}
                {{ actionInput('basin/forms/remove-studio-embed') }}
                {{ redirectInput(form.cpUrl) }}
                {{ hiddenInput('formUuid', form.uuid) }}
                <button type="submit" class="btn">{{ 'Remove embed code'|t('basin') }}</button>
            </form>
        {% endif %}
    {% else %}
        <p>{{ 'Optional. If you’ve designed this form in Basin’s Form Studio, paste its embed code here so templates can show it with `craft.basin.render()`. Basin doesn’t provide it through its API, so it has to be added once by hand.'|t('basin')|md(inlineOnly=true) }}</p>
        {% if canManage and form.detectedHostedId %}
            <form method="post" accept-charset="UTF-8" style="margin-bottom: var(--m);">
                {{ csrfInput() }}
                {{ actionInput('basin/forms/save-studio-embed') }}
                {{ redirectInput(form.cpUrl) }}
                {{ hiddenInput('formUuid', form.uuid) }}
                {{ hiddenInput('embed', 'https://usebasin.com/form/' ~ form.uuid ~ '/hosted/' ~ form.detectedHostedId) }}
                <p>{{ 'Basin’s submissions show this form’s Form Studio ID is `{id}`.'|t('basin', { id: form.detectedHostedId })|md(inlineOnly=true) }}</p>
                <button type="submit" class="btn submit">{{ 'Use detected embed'|t('basin') }}</button>
            </form>
            <p class="light">{{ 'Or paste the embed code yourself:'|t('basin') }}</p>
        {% endif %}
        {% if canManage %}
            <form method="post" accept-charset="UTF-8">
                {{ csrfInput() }}
                {{ actionInput('basin/forms/save-studio-embed') }}
                {{ redirectInput(form.cpUrl) }}
                {{ hiddenInput('formUuid', form.uuid) }}
                {{ forms.textareaField({
                    label: 'Embed code'|t('basin'),
                    instructions: 'In <a href="{url}" target="_blank" rel="noopener">Form Studio</a>, open the form’s embed options and copy the `<script>` tag. The script URL or the hosted form URL also work.'|t('basin', { url: form.studioDashboardUrl }),
                    id: 'basin-embed',
                    name: 'embed',
                    value: embedInput,
                    class: 'code',
                    rows: 2,
                    placeholder: '<script src="https://hf.usebasin.com/hf/' ~ form.uuid ~ '-…js" async></script>',
                }) }}
                <button type="submit" class="btn {{ form.detectedHostedId ? '' : 'submit' }}">{{ 'Save embed code'|t('basin') }}</button>
            </form>
        {% else %}
            <p class="light">{{ 'Someone with permission to manage form settings can add it.'|t('basin') }}</p>
        {% endif %}
    {% endif %}

    {% if form.captcha == 'recaptcha' %}
        <hr>

        <h2>{{ 'reCAPTCHA version'|t('basin') }}</h2>
        {% set siteDefault = settings.recaptchaVersion %}
        {% set versionOptions = [
            { label: 'Site default ({version})'|t('basin', { version: siteDefault }), value: '' },
            { label: 'v3 (invisible)'|t('basin'), value: 'v3' },
            { label: 'v2 (checkbox)'|t('basin'), value: 'v2' },
        ] %}
        {% if canManage %}
            <form method="post" accept-charset="UTF-8">
                {{ csrfInput() }}
                {{ actionInput('basin/forms/save-recaptcha-version') }}
                {{ redirectInput(form.cpUrl) }}
                {{ hiddenInput('formUuid', form.uuid) }}
                {{ forms.selectField({
                    label: 'Version for this form'|t('basin'),
                    instructions: 'Basin accepts either version. Templates can still choose one for a single form tag with `data-basin-recaptcha="v2"`.'|t('basin'),
                    id: 'basin-recaptcha-version',
                    name: 'recaptchaVersion',
                    options: versionOptions,
                    value: form.recaptchaVersion ?? '',
                }) }}
                <button type="submit" class="btn">{{ 'Save'|t('app') }}</button>
            </form>
        {% else %}
            <p>{{ form.recaptchaVersion ? form.recaptchaVersion : 'Site default ({version})'|t('basin', { version: siteDefault }) }}</p>
        {% endif %}
    {% endif %}

    <hr>

    <h2>{{ 'Template code'|t('basin') }}</h2>
    {% set q = "'" ~ form.uuid ~ "'" %}
    {% set snippet = form.isStudioForm
        ? "{{ craft.basin.render(" ~ q ~ ") }}"
        : "{% set form = craft.basin.form(" ~ q ~ ") %}\n{% if form %}\n  <form action=\"{{ form.action }}\" method=\"post\">\n    <input type=\"email\" name=\"email\" required>\n    <textarea name=\"message\"></textarea>\n    <button type=\"submit\">Send</button>\n  </form>\n{% endif %}"
    %}
    <div class="flex" style="justify-content: space-between; align-items: center; margin-bottom: var(--s);">
        <p style="margin: 0;">{{ form.isStudioForm
            ? 'Shows the Form Studio embed. If the form is ever removed from the Basin project, it outputs nothing.'|t('basin')
            : 'Spam protection that Basin requires for this form is added automatically.'|t('basin') }}</p>
        <button type="button" id="basin-copy-snippet" class="btn small" data-icon="clipboard" aria-label="{{ 'Copy template code to clipboard'|t('basin') }}">{{ 'Copy'|t('basin') }}</button>
    </div>
    <pre class="code" style="margin: 0; padding: var(--s) var(--m); background: var(--gray-050); border-radius: var(--small-border-radius); overflow-x: auto;"><code id="basin-snippet">{{ snippet }}</code></pre>

    {% js %}
        document.getElementById('basin-copy-snippet').addEventListener('click', async (event) => {
            const text = document.getElementById('basin-snippet').textContent;
            try {
                await navigator.clipboard.writeText(text);
            } catch (e) {
                // Fallback for browsers that block the async clipboard API.
                const textarea = Object.assign(document.createElement('textarea'), { value: text });
                document.body.appendChild(textarea);
                textarea.select();
                document.execCommand('copy');
                textarea.remove();
            }
            Craft.cp.displayNotice(Craft.t('app', 'Copied to clipboard.'));
            event.currentTarget.focus();
        });
    {% endjs %}
{% endblock %}

{% block details %}
    <div class="meta read-only">
        <div class="data">
            <h5 class="heading">{{ 'Form Studio embed'|t('basin') }}</h5>
            <div class="value">{{ form.isStudioForm ? (studioStatus == 'broken' ? 'Not working'|t('basin') : 'Added'|t('basin')) : 'None'|t('basin') }}</div>
        </div>
        <div class="data">
            <h5 class="heading">{{ 'Spam protection'|t('basin') }}</h5>
            <div class="value">
                {% include 'basin/forms/_spam' %}
                <div><a href="{{ form.basinUrl }}" target="_blank" rel="noopener" class="smalltext" title="{{ 'In Basin, open the form’s Settings → Spam.'|t('basin') }}">{{ 'Change in Basin'|t('basin') }}</a></div>
            </div>
        </div>
        {% if canViewCounts %}
            <div class="data">
                <h5 class="heading">{{ 'Inbox'|t('basin') }}</h5>
                <div class="value">{{ form.inboxCount|number }}</div>
            </div>
            <div class="data">
                <h5 class="heading">{{ 'Spam'|t('basin') }}</h5>
                <div class="value">{{ form.spamCount|number }}</div>
            </div>
            <div class="data">
                <h5 class="heading">{{ 'Trash'|t('basin') }}</h5>
                <div class="value">{{ form.trashCount|number }}</div>
            </div>
        {% endif %}
        <div class="data">
            <h5 class="heading">{{ 'Redirect'|t('basin') }}</h5>
            <div class="value">{{ form.redirectUrl ?? 'Basin’s thank-you page'|t('basin') }}</div>
        </div>
        <div class="data">
            <h5 class="heading">{{ 'Always respond with JSON'|t('basin') }}</h5>
            <div class="value">{{ form.useAjax ? 'On'|t('basin') : 'Off'|t('basin') }}</div>
        </div>
        <div class="data">
            <h5 class="heading">{{ 'Timezone'|t('basin') }}</h5>
            <div class="value">{{ form.timezone }}</div>
        </div>
        {% if form.retentionDays %}
            <div class="data">
                <h5 class="heading">{{ 'Retention'|t('basin') }}</h5>
                <div class="value">{{ '{num, plural, =1{1 day} other{# days}}'|t('basin', { num: form.retentionDays }) }}</div>
            </div>
        {% endif %}
        <div class="data">
            <h5 class="heading">{{ 'Updated'|t('basin') }}</h5>
            <div class="value">{{ form.dateUpdated ? form.dateUpdated|timestamp('short') }}</div>
        </div>
    </div>
    <div class="meta read-only">
        <p class="light">{{ 'To change these settings, edit the form in Basin.'|t('basin') }}</p>
    </div>
{% endblock %}
