{% extends '_layouts/cp' %}
{% import '_includes/forms' as forms %}

{% set title = form.name %}
{% set selectedSubnavItem = 'forms' %}
{% set crumbs = [
    { label: settings.getNavLabel(), url: url('basin') },
    { label: 'Forms'|t('basin'), url: url('basin/forms') },
] %}

{% block actionButton %}
    <a class="btn" href="{{ form.basinUrl }}" target="_blank" rel="noopener" data-icon="external">{{ 'Open in Basin'|t('basin') }}</a>
{% endblock %}

{% block content %}
    {% include 'basin/_includes/state' with { state: 'ready' } %}

    {% if form.hasTurnstileProblem %}
        <blockquote class="note warning">
            <p>{{ 'This form requires Turnstile, but no Turnstile site key is set in Basin, so every submission will fail. Add your Cloudflare Turnstile keys in the form’s Spam settings in Basin.'|t('basin') }}</p>
        </blockquote>
    {% endif %}

    {% if studioStatus == 'broken' %}
        <blockquote class="note warning">
            <p>{{ 'The saved Form Studio embed code no longer works. The form may have been deleted or republished in Form Studio. Paste the current embed code below.'|t('basin') }}</p>
        </blockquote>
    {% endif %}

    {{ forms.copytextField({
        label: 'Endpoint URL'|t('basin'),
        instructions: 'Use this as the form’s `action`. Every Basin form accepts submissions here, including Form Studio forms.'|t('basin'),
        id: 'basin-endpoint',
        value: form.action,
        class: 'code',
    }) }}

    <hr>

    <h2>{{ 'Form Studio embed'|t('basin') }}</h2>
    {% if form.isStudioForm and studioStatus != 'broken' %}
        <p>{{ 'Saved. Templates can show this form with `form.render()`.'|t('basin')|md(inlineOnly=true) }}{% if studioStatus == 'unknown' %} <span class="light">{{ 'Basin couldn’t be reached to check it just now.'|t('basin') }}</span>{% endif %}</p>
        <p><code>{{ form.studioScriptUrl }}</code></p>
        {% if canEditStudio %}
            <form method="post" accept-charset="UTF-8">
                {{ csrfInput() }}
                {{ actionInput('basin/forms/remove-studio-embed') }}
                {{ redirectInput(form.cpUrl) }}
                {{ hiddenInput('formUuid', form.uuid) }}
                <button type="submit" class="btn">{{ 'Remove embed code'|t('basin') }}</button>
            </form>
        {% endif %}
    {% else %}
        <p>{{ 'If this form was built in Basin’s Form Studio, paste its embed code here so templates can show it with `form.render()`. Basin doesn’t provide it through its API, so it has to be added once by hand.'|t('basin')|md(inlineOnly=true) }}</p>
        {% if canEditStudio %}
            <form method="post" accept-charset="UTF-8">
                {{ csrfInput() }}
                {{ actionInput('basin/forms/save-studio-embed') }}
                {{ redirectInput(form.cpUrl) }}
                {{ hiddenInput('formUuid', form.uuid) }}
                {{ forms.textareaField({
                    label: 'Embed code'|t('basin'),
                    instructions: 'In <a href="{url}" target="_blank" rel="noopener">Form Studio</a>, open the form’s embed options and copy the `<script>` tag. The script URL or the hosted form URL also work.'|t('basin', { url: form.studioDashboardUrl }),
                    id: 'basin-embed',
                    name: 'embed',
                    value: embedInput,
                    class: 'code',
                    rows: 2,
                    placeholder: '<script src="https://hf.usebasin.com/hf/' ~ form.uuid ~ '-…js" async></script>',
                }) }}
                <button type="submit" class="btn submit">{{ 'Save embed code'|t('basin') }}</button>
            </form>
        {% elseif currentUser.admin %}
            <p class="light">{{ 'Embed codes are saved in project config, so they can only be added where admin changes are allowed. Add it in your development environment and deploy.'|t('basin') }}</p>
        {% else %}
            <p class="light">{{ 'An admin can add it.'|t('basin') }}</p>
        {% endif %}
    {% endif %}

    <hr>

    <h2>{{ 'Template code'|t('basin') }}</h2>
    {% set q = "'" ~ form.uuid ~ "'" %}
    {% set snippet = form.isStudioForm
        ? "{% set form = craft.basin.form(" ~ q ~ ") %}\n{% if form %}\n  {{ form.render() }}\n{% endif %}"
        : "{% set form = craft.basin.form(" ~ q ~ ") %}\n{% if form %}\n  <form action=\"{{ form.action }}\" method=\"post\">\n    <input type=\"email\" name=\"email\" required>\n    <textarea name=\"message\"></textarea>\n    <button type=\"submit\">Send</button>\n  </form>\n{% endif %}"
    %}
    <div class="flex" style="justify-content: space-between; align-items: center; margin-bottom: var(--s);">
        <p style="margin: 0;">{{ 'Spam protection that Basin requires for this form is added automatically.'|t('basin') }}</p>
        <button type="button" id="basin-copy-snippet" class="btn small" data-icon="clipboard" aria-label="{{ 'Copy template code to clipboard'|t('basin') }}">{{ 'Copy'|t('basin') }}</button>
    </div>
    <pre class="code" style="margin: 0; padding: var(--s) var(--m); background: var(--gray-050); border-radius: var(--small-border-radius); overflow-x: auto;"><code id="basin-snippet">{{ snippet }}</code></pre>

    {% js %}
        document.getElementById('basin-copy-snippet').addEventListener('click', async (event) => {
            const text = document.getElementById('basin-snippet').textContent;
            try {
                await navigator.clipboard.writeText(text);
            } catch (e) {
                // Fallback for browsers that block the async clipboard API.
                const textarea = Object.assign(document.createElement('textarea'), { value: text });
                document.body.appendChild(textarea);
                textarea.select();
                document.execCommand('copy');
                textarea.remove();
            }
            Craft.cp.displayNotice(Craft.t('app', 'Copied to clipboard.'));
            event.currentTarget.focus();
        });
    {% endjs %}
{% endblock %}

{% block details %}
    <div class="meta read-only">
        <div class="data">
            <h5 class="heading">{{ 'Type'|t('basin') }}</h5>
            <div class="value">{% include 'basin/forms/_type' %}</div>
        </div>
        <div class="data">
            <h5 class="heading">{{ 'Spam protection'|t('basin') }}</h5>
            <div class="value">{% include 'basin/forms/_spam' %}</div>
        </div>
        {% if canViewCounts %}
            <div class="data">
                <h5 class="heading">{{ 'Inbox'|t('basin') }}</h5>
                <div class="value">{{ form.inboxCount|number }}</div>
            </div>
            <div class="data">
                <h5 class="heading">{{ 'Spam'|t('basin') }}</h5>
                <div class="value">{{ form.spamCount|number }}</div>
            </div>
            <div class="data">
                <h5 class="heading">{{ 'Trash'|t('basin') }}</h5>
                <div class="value">{{ form.trashCount|number }}</div>
            </div>
        {% endif %}
        <div class="data">
            <h5 class="heading">{{ 'Redirect'|t('basin') }}</h5>
            <div class="value">{{ form.redirectUrl ?? 'Basin’s thank-you page'|t('basin') }}</div>
        </div>
        <div class="data">
            <h5 class="heading">{{ 'AJAX'|t('basin') }}</h5>
            <div class="value">{{ form.useAjax ? 'On'|t('basin') : 'Off'|t('basin') }}</div>
        </div>
        <div class="data">
            <h5 class="heading">{{ 'Timezone'|t('basin') }}</h5>
            <div class="value">{{ form.timezone }}</div>
        </div>
        {% if form.retentionDays %}
            <div class="data">
                <h5 class="heading">{{ 'Retention'|t('basin') }}</h5>
                <div class="value">{{ '{num, plural, =1{1 day} other{# days}}'|t('basin', { num: form.retentionDays }) }}</div>
            </div>
        {% endif %}
        <div class="data">
            <h5 class="heading">{{ 'Updated'|t('basin') }}</h5>
            <div class="value">{{ form.dateUpdated ? form.dateUpdated|timestamp('short') }}</div>
        </div>
    </div>
    <div class="meta read-only">
        <p class="light">{{ 'To change these settings, edit the form in Basin.'|t('basin') }}</p>
    </div>
{% endblock %}
