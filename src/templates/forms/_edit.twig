{% extends '_layouts/cp' %}
{% import '_includes/forms' as forms %}

{% set title = 'Edit “{name}”'|t('basin', { name: form.name }) %}
{% set selectedSubnavItem = 'forms' %}
{% set fullPageForm = loadError is null %}
{% set crumbs = [
    { label: settings.getNavLabel(), url: url('basin') },
    { label: 'Forms'|t('basin'), url: url('basin/forms') },
    { label: form.name, url: form.cpUrl },
] %}

{% block content %}
    {% css %}
        #main-content a[data-icon="external"]::before { margin-inline-end: 0.3em; }
        .basin-delete-modal .body { width: 460px; max-width: calc(100vw - 80px); }
        .basin-delete-modal .body p { margin-block: var(--s) var(--m); }
        .basin-chips { display: flex; flex-wrap: wrap; gap: 6px; margin: 8px 0 0; padding: 0; list-style: none; }
        .basin-chips:empty { display: none; }
        .basin-chip { display: inline-flex; align-items: center; gap: 6px; padding: 3px 4px 3px 10px; border: 1px solid var(--hairline-color); border-radius: 999px; background: var(--gray-050); line-height: 1.4; }
        .basin-chip.is-waiting, .basin-chip.is-verified { background: transparent; padding-inline-start: 8px; }
        .basin-chip.is-waiting { border-color: var(--warning-color); }
        .basin-chip.is-verified { border-color: var(--success-color); }
        .basin-chip-icon { display: inline-flex; width: 13px; height: 13px; color: var(--warning-color); }
        .is-verified .basin-chip-icon { color: var(--success-color); }
        .basin-chip-icon svg, .basin-chip-remove svg { width: 100%; height: 100%; }
        .basin-chip-remove { display: inline-flex; align-items: center; justify-content: center; width: 20px; height: 20px; padding: 4px; border-radius: 50%; color: var(--light-text-color); cursor: pointer; }
        .basin-chip-remove:hover, .basin-chip-remove:focus-visible { background: var(--gray-200); color: var(--text-color); }
        .basin-chips-note { display: flex; align-items: center; gap: 6px; margin: 8px 0 0; font-size: 12px; }
    {% endcss %}
    {% if loadError %}
        <blockquote class="note warning">
            <p>{{ 'Couldn’t load this form’s settings from Basin: {message}'|t('basin', { message: loadError }) }}</p>
        </blockquote>
    {% else %}
        {{ actionInput('basin/forms/save-settings') }}
        {{ hiddenInput('formUuid', form.uuid) }}

        {% if createdNotice %}
            <blockquote class="note" style="margin-bottom: var(--l);">
                <p>{{ createdNotice }}</p>
            </blockquote>
        {% endif %}

        {# General #}
        <h2>{{ 'General'|t('basin') }}</h2>

        {{ forms.textField({
            label: 'Name'|t('basin'),
            instructions: 'Only shown in the Control Panel and in Basin, not to visitors.'|t('basin'),
            id: 'basin-name',
            name: 'fields[name]',
            value: values.name,
            required: true,
            maxlength: 100,
            errors: errors.name ?? null,
        }) }}

        {{ forms.timeZoneField({
            label: 'Timezone'|t('basin'),
            instructions: 'Used for submission dates in Basin’s emails and exports.'|t('basin'),
            id: 'basin-timezone',
            name: 'fields[timezone]',
            value: values.timezone,
            errors: errors.timezone ?? null,
        }) }}

        <hr>

        {# Notifications #}
        <h2>{{ 'Notifications'|t('basin') }}</h2>
        <p class="light">{{ 'Basin emails new addresses asking them to verify, and they get no notifications until they do. The Basin account owner’s address doesn’t need verifying.'|t('basin') }}</p>

        {# Recipients are listed as chips, verified and pending together, as in Basin. The
           hidden input holds the list that's saved; addresses left out are dropped. #}
        {% set recipientFields = {
            notification_emails: { label: 'Send to'|t('basin'), instructions: 'Who Basin emails when someone submits the form. If there’s no one here, Basin emails the account owner.'|t('basin') },
            notification_cc_emails: { label: 'CC'|t('basin'), instructions: null },
            notification_bcc_emails: { label: 'BCC'|t('basin'), instructions: null },
        } %}
        {% for key, field in recipientFields %}
            {% set id = 'basin-' ~ key|replace('_', '-') %}
            {% set live = recipients[key].live %}
            {% set verified = live|map(e => e|lower) %}
            {% set waiting = recipients[key].pending|map(e => e|lower) %}
            {% set emails = values[key]|split(',')|map(e => e|trim)|filter(e => e != '') %}
            {% set anyWaiting = emails|filter(e => e|lower in waiting) is not empty %}
            {% set warning = key == 'notification_emails' and live is empty and anyWaiting
                ? 'None of these addresses are verified yet, so this form doesn’t email anyone.'|t('basin')
                : null %}
            {% set input %}
                <div class="basin-recipients" data-pending="{{ waiting|json_encode }}">
                    {{ hiddenInput('fields[' ~ key ~ ']', values[key], {
                        id: id ~ '-value',
                        data: { live: live|join(', '), pending: waiting|join(', ') },
                    }) }}
                    <input type="text" inputmode="email" class="text fullwidth" id="{{ id }}" autocomplete="off" spellcheck="false" autocapitalize="off" placeholder="{{ 'Type an address and press Enter'|t('basin') }}">
                    <ul class="basin-chips">
                        {% for email in emails %}
                            {% set isWaiting = email|lower in waiting %}
                            {% set isVerified = not isWaiting and email|lower in verified %}
                            <li class="basin-chip{{ isWaiting ? ' is-waiting' }}{{ isVerified ? ' is-verified' }}" data-email="{{ email }}"{% if isWaiting %} title="{{ 'Waiting for verification'|t('basin') }}"{% elseif isVerified %} title="{{ 'Verified'|t('basin') }}"{% endif %}>
                                {% if isWaiting %}<span class="basin-chip-icon" aria-hidden="true"><svg viewBox="0 0 16 16"><circle cx="8" cy="8" r="6.5" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M8 4.5V8l2.5 1.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg></span>{% elseif isVerified %}<span class="basin-chip-icon" aria-hidden="true"><svg viewBox="0 0 16 16"><circle cx="8" cy="8" r="6.5" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M5.3 8.2l1.9 1.9 3.6-3.8" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></span>{% endif %}
                                <span class="basin-chip-email">{{ email }}</span>
                                {% if isWaiting %}<span class="visually-hidden">{{ '(waiting for verification)'|t('basin') }}</span>{% elseif isVerified %}<span class="visually-hidden">{{ '(verified)'|t('basin') }}</span>{% endif %}
                                <button type="button" class="basin-chip-remove" aria-label="{{ 'Remove {email}'|t('basin', { email: email }) }}"><svg viewBox="0 0 16 16"><path d="M4 4l8 8M12 4l-8 8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg></button>
                            </li>
                        {% endfor %}
                    </ul>
                    {% if anyWaiting %}
                        <p class="basin-chips-note light"><span class="basin-chip-icon" aria-hidden="true"><svg viewBox="0 0 16 16"><circle cx="8" cy="8" r="6.5" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M8 4.5V8l2.5 1.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg></span>{{ 'Waiting for verification. Basin has emailed these addresses, and they won’t get notifications until they verify.'|t('basin') }}</p>
                    {% endif %}
                </div>
            {% endset %}
            {{ forms.field({
                label: field.label,
                instructions: field.instructions,
                id: id,
                warning: warning,
                errors: errors[key] ?? null,
            }, input) }}
        {% endfor %}
        <template id="basin-chip-template">
            <li class="basin-chip" data-email="">
                <span class="basin-chip-email"></span>
                <button type="button" class="basin-chip-remove" aria-label=""><svg viewBox="0 0 16 16"><path d="M4 4l8 8M12 4l-8 8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg></button>
            </li>
        </template>

        {{ forms.textField({
            label: 'Subject'|t('basin'),
            instructions: 'Leave blank for Basin’s default. Basin’s merge tags work here.'|t('basin'),
            id: 'basin-notification-subject',
            name: 'fields[notification_subject]',
            value: values.notification_subject,
            errors: errors.notification_subject ?? null,
        }) }}

        {{ forms.textField({
            label: 'From name'|t('basin'),
            instructions: 'Leave blank for “Basin”.'|t('basin'),
            id: 'basin-notification-from-name',
            name: 'fields[notification_from_name]',
            value: values.notification_from_name,
            errors: errors.notification_from_name ?? null,
        }) }}

        {{ forms.lightswitchField({
            label: 'Leave the submitter out of reply-all'|t('basin'),
            instructions: 'Normally, replying to all on a notification includes the person who submitted the form.'|t('basin'),
            id: 'basin-exclude-submitter',
            name: 'fields[exclude_submitter_from_reply]',
            on: values.exclude_submitter_from_reply,
        }) }}

        <hr>

        {# After submitting #}
        <h2>{{ 'After submitting'|t('basin') }}</h2>

        {{ forms.textField({
            label: 'Redirect URL'|t('basin'),
            instructions: 'Where visitors go after submitting. Leave blank to show Basin’s thank-you page.'|t('basin'),
            id: 'basin-redirect-url',
            name: 'fields[redirect_url]',
            value: values.redirect_url,
            type: 'url',
            placeholder: 'https://example.com/thanks',
            errors: errors.redirect_url ?? null,
        }) }}

        <div class="field">
            <div class="heading"><label>{{ 'Thank-you page'|t('basin') }}</label></div>
            <div class="instructions"><p>{{ 'Shown when there’s no redirect URL. Leave a field blank for Basin’s default.'|t('basin') }}</p></div>
        </div>

        {{ forms.textField({
            label: 'Heading'|t('basin'),
            id: 'basin-redirect-heading',
            name: 'fields[redirect_heading]',
            value: values.redirect_heading,
            placeholder: 'Thanks for the message!'|t('basin'),
            errors: errors.redirect_heading ?? null,
        }) }}

        {{ forms.textareaField({
            label: 'Message'|t('basin'),
            id: 'basin-redirect-message',
            name: 'fields[redirect_message]',
            value: values.redirect_message,
            rows: 2,
            placeholder: 'Your submission was successful'|t('basin'),
            errors: errors.redirect_message ?? null,
        }) }}

        {{ forms.textField({
            label: 'Button text'|t('basin'),
            id: 'basin-redirect-button-text',
            name: 'fields[redirect_button_text]',
            value: values.redirect_button_text,
            placeholder: 'Back to home'|t('basin'),
            errors: errors.redirect_button_text ?? null,
        }) }}

        <div class="flex" style="align-items: flex-start; gap: var(--xl);">
            {{ forms.colorField({
                label: 'Button colour'|t('basin'),
                id: 'basin-redirect-button-bg',
                name: 'fields[redirect_button_background_color]',
                value: values.redirect_button_background_color,
                errors: errors.redirect_button_background_color ?? null,
            }) }}
            {{ forms.colorField({
                label: 'Button text colour'|t('basin'),
                id: 'basin-redirect-button-color',
                name: 'fields[redirect_button_text_color]',
                value: values.redirect_button_text_color,
                errors: errors.redirect_button_text_color ?? null,
            }) }}
        </div>

        {{ forms.lightswitchField({
            label: 'Always respond with JSON'|t('basin'),
            instructions: 'Basin’s “Enable AJAX”. Only turn this on if every page submits this form with JavaScript: otherwise visitors see raw JSON instead of the thank-you page or redirect.'|t('basin'),
            id: 'basin-use-ajax',
            name: 'fields[use_ajax]',
            on: values.use_ajax,
        }) }}

        <hr>

        {# Auto-reply #}
        <h2>{{ 'Auto-reply'|t('basin') }}</h2>

        {{ forms.lightswitchField({
            label: 'Send an auto-reply'|t('basin'),
            instructions: 'Emails the person who submitted the form. The form needs a field named `email` or `email_address`.'|t('basin'),
            id: 'basin-autoreply',
            name: 'fields[autoreply]',
            on: values.autoreply,
            toggle: 'basin-autoreply-fields',
        }) }}

        <div id="basin-autoreply-fields" class="{{ values.autoreply ? '' : 'hidden' }}">
            {{ forms.textField({
                label: 'Subject'|t('basin'),
                instructions: 'Leave blank for Basin’s default. Basin’s merge tags work in every auto-reply field.'|t('basin'),
                id: 'basin-autoreply-subject',
                name: 'fields[autoreply_subject]',
                value: values.autoreply_subject,
                errors: errors.autoreply_subject ?? null,
            }) }}

            {{ forms.textField({
                label: 'From name'|t('basin'),
                instructions: 'Leave blank for “Basin”.'|t('basin'),
                id: 'basin-autoreply-from-name',
                name: 'fields[autoreply_from_name]',
                value: values.autoreply_from_name,
                errors: errors.autoreply_from_name ?? null,
            }) }}

            {{ forms.textField({
                label: 'Reply-to email'|t('basin'),
                instructions: 'Where replies to the auto-reply go. Leave blank for the Basin account owner.'|t('basin'),
                id: 'basin-autoreply-email',
                name: 'fields[autoreply_email]',
                value: values.autoreply_email,
                type: 'email',
                errors: errors.autoreply_email ?? null,
            }) }}

            {{ forms.textField({
                label: 'Greeting'|t('basin'),
                id: 'basin-autoreply-greeting',
                name: 'fields[autoreply_greeting]',
                value: values.autoreply_greeting,
                placeholder: 'Hello,'|t('basin'),
                errors: errors.autoreply_greeting ?? null,
            }) }}

            {{ forms.textareaField({
                label: 'Message'|t('basin'),
                id: 'basin-autoreply-body',
                name: 'fields[autoreply_body]',
                value: values.autoreply_body,
                rows: 6,
                errors: errors.autoreply_body ?? null,
            }) }}

            {{ forms.textField({
                label: 'Signature name'|t('basin'),
                instructions: 'Appears under the message. Leave blank to leave it out.'|t('basin'),
                id: 'basin-autoreply-name',
                name: 'fields[autoreply_name]',
                value: values.autoreply_name,
                errors: errors.autoreply_name ?? null,
            }) }}

            {{ forms.textField({
                label: 'Signature title or tagline'|t('basin'),
                instructions: 'Appears after the signature name. Leave blank to leave it out.'|t('basin'),
                id: 'basin-autoreply-title',
                name: 'fields[autoreply_title]',
                value: values.autoreply_title,
                errors: errors.autoreply_title ?? null,
            }) }}
        </div>

        <hr>

        {# Data #}
        <h2>{{ 'Data'|t('basin') }}</h2>

        {{ forms.textField({
            label: 'Keep submissions for'|t('basin'),
            instructions: 'Days, from 1 to {max}. Basin deletes older submissions.'|t('basin', { max: 3650 }),
            id: 'basin-retention-days',
            name: 'fields[retention_days]',
            value: values.retention_days,
            type: 'number',
            min: 1,
            max: 3650,
            size: 6,
            unit: 'days'|t('basin'),
            errors: errors.retention_days ?? null,
        }) }}

        <hr>

        {# Managed in Basin #}
        <h2>{{ 'Managed in Basin'|t('basin') }}</h2>

        <div class="field">
            <div class="heading"><label>{{ 'Spam protection'|t('basin') }}</label></div>
            <div class="input">
                <p>{% include 'basin/forms/_spam' %}</p>
                <p><a href="{{ form.basinSpamUrl }}" target="_blank" rel="noopener" data-icon="external">{{ 'Change in Basin'|t('basin') }}</a></p>
            </div>
        </div>

        <div class="field">
            <div class="heading"><label>{{ 'Webhooks'|t('basin') }}</label></div>
            <div class="input">
                <p>{{ form.webhookCount ? '{num, plural, =1{1 webhook} other{# webhooks}}'|t('basin', { num: form.webhookCount }) : 'None'|t('basin') }}</p>
                <p><a href="{{ form.getBasinSettingsUrl('integrations/zapier') }}" target="_blank" rel="noopener" data-icon="external">{{ 'Change in Basin'|t('basin') }}</a></p>
            </div>
        </div>

        <p class="light">{{ 'Email design, mail templates and sending domains are also set in Basin.'|t('basin') }}</p>

        {% if canDelete %}
            <hr>

            <h2>{{ 'Delete form'|t('basin') }}</h2>
            <p>{{ 'Deletes the form and all its submissions ({inbox} in the inbox, {spam} in spam, {trash} in the trash) from Basin. Its endpoint stops working straight away. This can’t be undone.'|t('basin', {
                inbox: form.inboxCount|number,
                spam: form.spamCount|number,
                trash: form.trashCount|number,
            }) }}</p>
            <button type="button" class="btn caution" id="basin-delete-open" aria-haspopup="dialog">{{ 'Delete form…'|t('basin') }}</button>

            {# The confirmation dialog. It's its own form, posted separately from the settings. #}
            <template id="basin-delete-template">
                <form class="modal fitted basin-delete-modal" method="post" accept-charset="UTF-8" role="dialog" aria-modal="true" aria-labelledby="basin-delete-heading">
                    {{ csrfInput() }}
                    {{ actionInput('basin/forms/delete') }}
                    {{ hiddenInput('formUuid', form.uuid) }}
                    <div class="body">
                        <h2 id="basin-delete-heading">{{ 'Delete “{name}”?'|t('basin', { name: form.name }) }}</h2>
                        <p>{{ 'This deletes the form and all its submissions from Basin: {inbox} in the inbox, {spam} in spam and {trash} in the trash. Its endpoint stops working straight away, and this can’t be undone.'|t('basin', {
                            inbox: form.inboxCount|number,
                            spam: form.spamCount|number,
                            trash: form.trashCount|number,
                        }) }}</p>
                        <div class="field">
                            <div class="heading">
                                <label for="basin-delete-name">{{ 'Type <code>{name}</code> to confirm.'|t('basin', { name: form.name|e })|raw }}</label>
                            </div>
                            <div class="input">
                                <input type="text" class="text fullwidth" id="basin-delete-name" name="confirmName" autocomplete="off" spellcheck="false" autocapitalize="off">
                            </div>
                        </div>
                    </div>
                    <div class="footer">
                        <div class="buttons right">
                            <button type="button" class="btn" data-cancel>{{ 'Cancel'|t('app') }}</button>
                            <button type="submit" class="btn submit disabled" disabled data-confirm>{{ 'Delete form'|t('basin') }}</button>
                        </div>
                    </div>
                </form>
            </template>
        {% endif %}
    {% endif %}
{% endblock %}

{% if loadError is null %}
    {% js %}
        (() => {
            // Recipients: type an address and press Enter (or a comma) to add it as a chip.
            const split = (v) => (v || '').split(/[\s,;]+/).filter(Boolean);
            const isEmail = (v) => /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v);
            const chipTemplate = document.getElementById('basin-chip-template');
            const removeLabel = {{ 'Remove {email}'|t('basin')|json_encode|raw }};
            const recipients = [...document.querySelectorAll('.basin-recipients')].map((root) => {
                const value = root.querySelector('input[type="hidden"]');
                const input = root.querySelector('input[type="text"]');
                const list = root.querySelector('.basin-chips');
                const note = root.querySelector('.basin-chips-note');
                const chips = () => [...list.children];
                const sync = () => {
                    value.value = chips().map((chip) => chip.dataset.email).join(', ');
                    if (note) {
                        note.hidden = !list.querySelector('.is-waiting');
                    }
                };
                // Adds what's been typed. Anything that isn't an address stays in the box.
                const add = () => {
                    const parts = split(input.value);
                    const bad = parts.filter((part) => !isEmail(part));
                    for (const email of parts.filter(isEmail)) {
                        if (!chips().some((chip) => chip.dataset.email.toLowerCase() === email.toLowerCase())) {
                            const chip = chipTemplate.content.firstElementChild.cloneNode(true);
                            chip.dataset.email = email;
                            chip.querySelector('.basin-chip-email').textContent = email;
                            chip.querySelector('.basin-chip-remove').setAttribute('aria-label', removeLabel.replace('{email}', email));
                            list.append(chip);
                        }
                    }
                    input.value = bad.join(', ');
                    input.classList.toggle('error', bad.length > 0);
                    sync();
                    return bad.length === 0;
                };
                input.addEventListener('keydown', (event) => {
                    if (event.key === 'Enter' || event.key === ',' || event.key === ';') {
                        event.preventDefault();
                        add();
                    }
                });
                input.addEventListener('blur', add);
                input.addEventListener('paste', () => setTimeout(add));
                list.addEventListener('click', (event) => {
                    const button = event.target.closest('.basin-chip-remove');
                    if (button) {
                        button.closest('.basin-chip').remove();
                        sync();
                        input.focus();
                    }
                });
                return { value, input, add };
            });

            // New Send to addresses get nothing until they’re verified (spec §6.7). If Send to was
            // empty, the account owner was getting the emails, and they stop too.
            const to = document.getElementById('basin-notification-emails-value');
            $('#main-form').on('submit', (event) => {
                const stop = () => {
                    event.preventDefault();
                    event.stopImmediatePropagation();
                };
                const invalid = recipients.find((field) => !field.add());
                if (invalid) {
                    stop();
                    invalid.input.focus();
                    Craft.cp.displayError({{ 'That isn’t an email address.'|t('basin')|json_encode|raw }});
                    return;
                }
                if (!to) {
                    return;
                }
                const lower = (v) => split(v).map((email) => email.toLowerCase());
                const live = lower(to.dataset.live);
                const waiting = lower(to.dataset.pending);
                const current = lower(to.value);
                const added = current.filter((email) => !live.includes(email) && !waiting.includes(email));
                // With nothing verified and something pending, the form already emails no one.
                if (!added.length || (!live.length && waiting.length)) {
                    return;
                }
                const message = !live.length
                    ? {{ 'Basin will email the new addresses to verify them. Until one is verified, this form won’t email anyone, not even the Basin account owner. Save anyway?'|t('basin')|json_encode|raw }}
                    : !current.some((email) => live.includes(email))
                        ? {{ 'Basin will email the new addresses to verify them. Until one is verified, this form won’t email anyone. Save anyway?'|t('basin')|json_encode|raw }}
                        : {{ 'Basin will email any new addresses to verify them. Until they’re verified, they won’t receive notifications. Save anyway?'|t('basin')|json_encode|raw }};
                if (!confirm(message)) {
                    stop();
                }
            });

            // Delete: a dialog whose button only works once the form's name is typed exactly.
            const open = document.getElementById('basin-delete-open');
            const template = document.getElementById('basin-delete-template');
            if (open && template) {
                const name = {{ form.name|json_encode|raw }};
                let modal, input, confirmButton;

                const update = () => {
                    const matches = input.value.trim() === name;
                    confirmButton.disabled = !matches;
                    confirmButton.classList.toggle('disabled', !matches);
                };

                open.addEventListener('click', () => {
                    if (!modal) {
                        const container = template.content.firstElementChild.cloneNode(true);
                        input = container.querySelector('input[name="confirmName"]');
                        confirmButton = container.querySelector('[data-confirm]');
                        input.addEventListener('input', update);
                        container.querySelector('[data-cancel]').addEventListener('click', () => modal.hide());
                        container.addEventListener('submit', (event) => {
                            if (confirmButton.disabled) {
                                event.preventDefault();
                                return;
                            }
                            confirmButton.classList.add('loading');
                            confirmButton.disabled = true;
                        });
                        modal = new Garnish.Modal(container, {
                            autoShow: false,
                            onFadeIn: () => input.focus(),
                            onHide: () => open.focus(),
                        });
                    }
                    input.value = '';
                    update();
                    modal.show();
                });
            }
        })();
    {% endjs %}
{% endif %}
