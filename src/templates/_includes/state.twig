{#
  Empty and error states shared by Basin CP screens.
  Expects: state, settings, error, staleSince. Outputs nothing when ready.
#}
{% css %}
  {# .zilch enlarges its text; keep buttons at Craft's standard size. #}
  .basin-empty .btn { font-size: var(--font-size); }
{% endcss %}

{% if state == 'noKey' %}
    <div class="zilch basin-empty">
        <p>{{ 'Basin isn’t connected yet.'|t('basin') }}</p>
        {% if currentUser.admin %}
            <a class="btn submit" href="{{ url('basin/settings') }}">{{ 'Add your API key'|t('basin') }}</a>
        {% else %}
            <p>{{ 'Ask an admin to add a Basin API key in the plugin settings.'|t('basin') }}</p>
        {% endif %}
    </div>
{% elseif state == 'noProject' %}
    <div class="zilch basin-empty">
        <p>{{ 'No Basin project is linked to this site yet.'|t('basin') }}</p>
        {% if currentUser.admin %}
            <a class="btn submit" href="{{ url('basin/settings') }}">{{ 'Choose a project'|t('basin') }}</a>
        {% endif %}
    </div>
{% elseif state == 'projectMissing' %}
    <blockquote class="note warning">
        <p>{{ 'The linked Basin project (ID {id}) wasn’t found. It may have been deleted, or the API key may not have access to it.'|t('basin', { id: settings.getProjectId() }) }}</p>
    </blockquote>
{% elseif staleSince %}
    <blockquote class="note warning">
        <p>{{ 'Couldn’t reach Basin, so this is the forms list from {time}. Front-end forms keep working.'|t('basin', { time: staleSince|timestamp('short') }) }}{% if error %} <span class="light">({{ error }})</span>{% endif %}</p>
    </blockquote>
{% elseif error %}
    <blockquote class="note warning">
        <p><strong>{{ 'Couldn’t reach Basin:'|t('basin') }}</strong> {{ error }}</p>
    </blockquote>
{% endif %}

{% if state == 'ready' and issues is defined and issues|length %}
    {% include 'basin/_includes/issues' %}
{% endif %}
