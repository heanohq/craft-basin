{#
  Warnings about forms this site uses but can't show (spec §13, §10.3).
  Expects: issues, project.
#}
{% set missing = issues|filter(i => i.reason == 'missing') %}
{% set noEmbed = issues|filter(i => i.reason == 'noEmbed') %}

{% macro row(issue) %}
    <li style="display: flex; gap: var(--s); align-items: baseline; flex-wrap: wrap;">
        <span>
            {%- if issue.form -%}
                <a href="{{ issue.form.cpUrl }}">{{ issue.form.name }}</a>
            {%- else -%}
                <code>{{ issue.uuid }}</code>
            {%- endif -%}
            {%- if issue.lastUrl %}, {{ 'last requested from {url}'|t('basin', { url: issue.lastUrl }) }}{% endif %},
            {{ issue.lastSeen|timestamp('short') }}
            {%- if issue.source == 'field' %} <span class="light">({{ 'in a Basin Form field'|t('basin') }})</span>{% endif %}
        </span>
        <form method="post" accept-charset="UTF-8" style="display: inline;">
            {{ csrfInput() }}
            {{ actionInput('basin/forms/dismiss-issue') }}
            {{ hiddenInput('id', issue.id) }}
            <button type="submit" class="btn small">{{ 'Dismiss'|t('basin') }}</button>
        </form>
    </li>
{% endmacro %}

{% if missing|length %}
    <blockquote class="note warning" style="margin-bottom: var(--m);">
        <p><strong>{{ '{count, plural, =1{This site uses a form that isn’t} other{This site uses # forms that aren’t}} in the Basin project “{project}”.'|t('basin', { count: missing|length, project: project.name ?? '' }) }}</strong>
        {{ 'They may have been deleted or moved to another Basin project.'|t('basin') }}</p>
        <ul style="margin-top: var(--xs);">
            {% for issue in missing %}{{ _self.row(issue) }}{% endfor %}
        </ul>
    </blockquote>
{% endif %}

{% if noEmbed|length %}
    <blockquote class="note warning" style="margin-bottom: var(--m);">
        <p><strong>{{ '{count, plural, =1{A Form Studio form needs} other{# Form Studio forms need}} its embed code.'|t('basin', { count: noEmbed|length }) }}</strong>
        {{ 'Visitors see nothing where these forms should be until the embed code is added on the form’s page.'|t('basin') }}</p>
        <ul style="margin-top: var(--xs);">
            {% for issue in noEmbed %}{{ _self.row(issue) }}{% endfor %}
        </ul>
    </blockquote>
{% endif %}
