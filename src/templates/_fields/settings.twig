{% import '_includes/forms' as forms %}

{{ forms.radioGroupField({
    label: 'Selectable forms'|t('basin'),
    instructions: 'Which kinds of Basin form editors can choose. Choose “Form Studio forms with embed code” if your template only calls `render()`, so editors can’t pick a form it can’t show.'|t('basin'),
    id: 'selectable',
    name: 'selectable',
    options: [
        { label: 'All forms'|t('basin'), value: 'all' },
        { label: 'Endpoint forms'|t('basin'), value: 'endpoint' },
        { label: 'Form Studio forms with embed code'|t('basin'), value: 'studio' },
    ],
    value: field.selectable,
}) }}

{% if basinForms|length %}
    {{ forms.checkboxGroupField({
        label: 'Limit to these forms'|t('basin'),
        instructions: 'Leave all unchecked to allow every form of the kind chosen above.'|t('basin'),
        id: 'allowedForms',
        name: 'allowedForms',
        options: basinForms|map(f => { label: f.name, value: f.uuid }),
        values: field.allowedForms,
    }) }}
{% else %}
    <p class="light">{{ 'Connect Basin and link a project in the plugin settings to limit this field to particular forms.'|t('basin') }}</p>
{% endif %}
