<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         cacheDirectory=".phpunit.cache"
         defaultTestSuite="Integration">
    <testsuites>
        <testsuite name="Integration">
            <directory suffix="Test.php">tests/Feature</directory>
        </testsuite>
        <!-- Needs Pest 4's browser plugin and Playwright. See README. -->
        <testsuite name="Browser">
            <directory suffix="Test.php">tests/Browser</directory>
        </testsuite>
        <!-- The docs against the plugin. Needs the docs in .docs. See README. -->
        <testsuite name="Docs">
            <directory suffix="Test.php">tests/Docs</directory>
        </testsuite>
        <!-- The real CAPTCHA providers under the docs' CSP. Needs the network,
             the docs, and the same as Browser. -->
        <testsuite name="Providers">
            <directory suffix="Test.php">tests/Providers</directory>
        </testsuite>
        <!-- Run on its own, outside a transaction. See tests/Uninstall. -->
        <testsuite name="Uninstall">
            <directory suffix="Test.php">tests/Uninstall</directory>
        </testsuite>
    </testsuites>
    <php>
        <!-- Never a real site's database. See config/db.php. -->
        <env name="CRAFT_DB_DATABASE" value="basin_tests" force="true"/>
        <env name="CRAFT_DB_TABLE_PREFIX" value="" force="true"/>
    </php>
</phpunit>
